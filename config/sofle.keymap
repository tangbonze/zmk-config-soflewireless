 *
 * Sofle 分体键盘键位定义 —— DYA Studio 版
 *
 * 布局沿用 ZMK 内置 sofle shield 的矩阵变换（app/boards/shields/sofle/sofle.dtsi
 * 里的 default_transform，chosen 到 josefadamcik_sofle_layout）。
 * 每层的绑定数必须严格为 12 / 12 / 12 / 14 / 10（两半合计 60 个矩阵位置，
 * 其中 2 个位置在 dtsi 里被映射为编码器，实际开关 58 枚），否则 devicetree 报错。
 *
 * 层设计：
 *   0 DEFAULT  主键区。**与原 main 分支完全一致**，未做任何改动。
 *   1 LOWER    F 键 / 数字 / 符号（原main 分支内容，末尾加 &mo 0 兜底）
 *   2 RAISE    蓝牙配置档 / 导航 / 编辑（原 main 分支内容 + DYA 键位）
 *   3 ADJUST   媒体 / 亮度 / 蓝牙 / bootloader（DYA Studio 常用操作集中层）
 *
 * 进出方式：
 *   DEFAULT -> LOWER  左手第 4 枚拇指键（&mo 1）
 *   DEFAULT -> RAISE  右手第 2 枚拇指键（&lt 2，短按退格 / 长按进层）
 *   RAISE   -> ADJUST 左手第 2 枚拇指键（&mo 3）
 *   LOWER + RAISE 同按 -> ADJUST（conditional layer / tri_layer）
 *   LOWER / RAISE / ADJUST 的兜底位均为 &mo 0，按住可临时回到 DEFAULT
 *
 * ⚠️ 输出切换一律用 &out OUT_TOG，不要用 &out OUT_USB：
 *    后者是粘滞的 —— 切过去以后只要没插线蓝牙输出就被停掉，键盘完全没有输入，
 *    表现成"键盘突然坏了"。本文件三处输出切换均为 OUT_TOG。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        // LOWER + RAISE 同按 -> ADJUST
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  `    |  1  |  2  |  3  |  4  |  5  |                    |  6  |  7  |  8  |  9  |  0  |      |
            // |  ESC  |  Q  |  W  |  E  |  R  |  T  |                    |  Y  |  U  |  I  |  O  |  P  | BSPC |
            // |  TAB  |  A  |  S  |  D  |  F  |  G  |                    |  H  |  J  |  K  |  L  |  ;  |  '   |
            // | LSHFT |  Z  |  X  |  C  |  V  |  B  | MUTE |            | PWR |  N  |  M  |  ,  |  .  | RSHFT|
            //               | GUI | ALT | CTRL| LWR | ENT |                   | SPC | RSE | CTRL| ALT | GUI |
            //
            // 本层与原 main 分支逐键一致，未做改动，确保既有手感不受影响。
            // 第 3 行是 Sofle 特有的 14 键（MUTE 与外设电源占位），
            // 第 4 行的编码器不在矩阵内，由 sensor-bindings 单独接管。

            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                              &kp N6 &kp N7    &kp N8    &kp N9   &kp N0   &none
&kp ESC   &kp Q  &kp W    &kp E    &kp R     &kp T                               &kp Y  &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp TAB   &kp A  &kp S    &kp D    &kp F     &kp G                               &kp H  &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z  &kp X    &kp C    &kp V     &kp B  &kp C_MUTE &ext_power EP_TOG &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RSHFT
                 &kp LGUI &kp LALT &kp LCTRL &mo 1  &kp RET    &kp SPACE         &mo 2  &lt 2 BACKSPACE  &kp RALT  &kp RGUI
            >;

            // 左编码器 = 音量，右编码器 = 翻页
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |      |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7 |  F8  |  F9  | F10 | F11 |
            // |  `   |   1 |   2 |  3  |   4  |   5  |                   |  6  |  7  |  8  |  9  |  0  | F12 |
            // | trans|  !  |  @  |  #  |  $  |  %  |                   |  ^  |  &  |  *  |  (  |  )  |  |  |
            // | trans|  =  |  -  |  +  |  {  |  }  |   trans |  trans  |  [  |  ]  |  ;  |  :  |  \  | trans|
            //               |trans|trans|trans|trans|                         | SPC  | trans |trans | trans | trans |
            //
            // 与原 main 分支一致。最右 1 枚拇指键从 &trans 改成 &mo 0 作为兜底：
            // DYA Studio 的 Default Layer 面板可以把这层设成基础层，一旦被设成
            // 基础层，原本全是 &trans 的拇指区就会变成"死区"——既回不到 RAISE
            //（拿不到 &studio_unlock），也进不了 ADJUST。有 &mo 0 就不会锁死。

            bindings = <
&trans    &kp F1    &kp F2    &kp F3      &kp F4    &kp F5                    &kp F6    &kp F7   &kp F8          &kp F9    &kp F10   &kp F11
&kp GRAVE &kp N1    &kp N2    &kp N3      &kp N4    &kp N5                    &kp N6    &kp N7   &kp N8          &kp N9    &kp N0    &kp F12
&trans    &kp EXCL  &kp AT    &kp HASH    &kp DLLR  &kp PRCNT                 &kp CARET &kp AMPS &kp KP_MULTIPLY &kp LPAR  &kp RPAR  &kp PIPE
&trans    &kp EQUAL &kp MINUS &kp KP_PLUS &kp LBRC  &kp RBRC  &trans   &trans &kp LBKT  &kp RBKT &kp SEMI        &kp COLON &kp BSLH  &trans
                    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans    &trans    &mo 0
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |BTCLR| BT1  | BT2  |  BT3  |  BT4  |  BT5 |                   | trans  | trans | trans | trans | trans | trans|
            // |     | INS  | PSCR | GUI   |       |      |                   | PGUP|      |   ^   |      |       |      |
            // |     | ALT  | CTRL | SHIFT |       | CAPS |                   | PGDN |   <- |   v   |  ->  |  DEL  | BSPC |
            // |     | UNDO | CUT  | COPY  | PASTE |      |  trans |  trans     | trans  | trans | trans | trans | trans | trans |
            //              |STUDIO| ->ADJ |      |      |                      | trans | BASE  | trans |      |      |
            //
            // 前四行与原 main 分支一致（蓝牙配置档、导航、编辑、剪贴板）。
            // 第 5 行是新增的 DYA 拇指区：
            //   STUDIO = &studio_unlock，解锁 DYA Studio（被锁定时 Web Bluetooth 扫不到）；
            //   ->ADJ  = &mo 3，按住进 ADJUST 层；
            //   BASE   = &mo 0，按住临时回到 DEFAULT（RAISE 被设成基础层时的逃生口）。

            bindings = <
&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4             &trans    &trans    &trans   &trans    &trans  &trans
&trans     &kp INS      &kp PSCRN    &kp K_CMENU  &trans       &trans                   &kp PG_UP &trans    &kp UP   &trans    &kp N0  &trans
&trans     &kp LALT     &kp LCTRL    &kp LSHFT    &trans       &kp CLCK                 &kp PG_DN &kp LEFT  &kp DOWN &kp RIGHT &kp DEL &kp BSPC
&trans     &kp K_UNDO   &kp K_CUT    &kp K_COPY   &kp K_PASTE  &trans  &trans   &trans  &trans    &trans    &trans   &trans    &trans  &trans
                        &studio_unlock  &mo 3    &trans       &trans  &trans    &trans  &mo 0    &trans    &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |  F1 | F2 | F3 | F4 | F5 | F6  |                   | F7  | F8 | F9 | F10 | F11 | F12 |
            // | bri+|    |prev| PP |next|   |                   |     |MUT | Vo-| Vo+|     |    |
            // | bri-|    |    |    |    | BT1|                   | BT2 |    |    |     |     |BTCLR|
            // |trans|trans|trans|trans|trans|trans | trans |trans |trans|trans|trans |trans|trans|trans|
            //                      | BTLDR | OUT | UNLK |          |     | BASE |    |     |
            //
            // 进入方式：LOWER + RAISE 同按（tri_layer），或 RAISE 中按住
            // 左手第 2 枚拇指键（&mo 3）。
            //
            // BTLDR = &bootloader，进 bootloader（重刷固件用），放在左拇指内侧不易误触。
            // OUT   = &out OUT_TOG，USB / BLE 来回切。**不要**换成 &out OUT_USB：
            //         它是粘滞的，切过去没插线就完全没有输出，而本层不易进出会"哑掉"。
            // UNLK  = &studio_unlock，Studio 被锁定时的备用解锁位（RAISE 层还有一个）。
            // BASE  = &mo 0，按住临时回到 DEFAULT（ADJUST 被设成基础层时的逃生口）。
            //
            // BT_CLR 放在本层最右侧，远离主键区，避免误触清掉蓝牙配对。

            bindings = <
&kp F1        &kp F2  &kp F3     &kp F4    &kp F5     &kp F6                        &kp F7        &kp F8    &kp F9      &kp F10      &kp F11      &kp F12
&kp C_BRI_UP  &trans  &kp C_PREV &kp C_PP  &kp C_NEXT &trans                        &trans        &trans    &kp C_MUTE  &kp C_VOL_DN &kp C_VOL_UP &trans
&kp C_BRI_DN  &trans  &trans     &trans    &trans     &bt BT_SEL 0                  &bt BT_SEL 1  &trans    &trans      &trans       &trans       &bt BT_CLR
&trans        &trans  &trans     &trans    &trans     &trans   &trans   &trans         &trans        &trans    &trans      &trans       &trans       &trans
                      &bootloader  &out OUT_TOG  &studio_unlock  &trans               &trans        &mo 0     &trans       &trans      &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};